# Acesso público (opera respeitando o Row Level Security - RLS)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key"

# Acesso backend exclusivo (bypassa RLS para rotas administrativas)
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# Envio de e-mail transacional (api/enviar-email.js) via AWS SES
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="sua-access-key"
AWS_SECRET_ACCESS_KEY="sua-secret-key"
EMAIL_FROM="Love <contato@seudominio.com.br>"
EMAIL_WEBHOOK_SECRET="uma-string-aleatoria-so-sua"
