{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/cadastro.html", "destination": "/cadastro", "permanent": true },
    { "source": "/resetar-senha.html", "destination": "/resetar-senha", "permanent": true },
    { "source": "/convite-preview.html", "destination": "/convite-preview", "permanent": true },
    { "source": "/organizador.html", "destination": "/organizador", "permanent": true },
    { "source": "/duvidas", "destination": "/central-de-ajuda", "permanent": true },
    { "source": "/politica-de-privacidade", "destination": "/privacidade", "permanent": true }
  ],
  "rewrites": [
    { "source": "/cadastro", "destination": "/cadastro.html" },
    { "source": "/resetar-senha", "destination": "/resetar-senha.html" },
    { "source": "/convite-preview", "destination": "/convite-preview.html" },
    { "source": "/organizador", "destination": "/organizador.html" },
    { "source": "/login", "destination": "/" },
    { "source": "/termos", "destination": "/api/documento-legal?slug=termos" },
    { "source": "/privacidade", "destination": "/api/documento-legal?slug=privacidade" },
    { "source": "/personalizar", "destination": "/" },
    { "source": "/presentes", "destination": "/" },
    { "source": "/convidados", "destination": "/" },
    { "source": "/carteira", "destination": "/" },
    { "source": "/fornecedores", "destination": "/" },
    { "source": "/personalizar/:path*", "destination": "/" },
    { "source": "/presentes/:path*", "destination": "/" },
    { "source": "/convidados/:path*", "destination": "/" },
    { "source": "/carteira/:path*", "destination": "/" },
    { "source": "/fornecedores/:path*", "destination": "/" },
    { "source": "/notificacoes", "destination": "/" },
    { "source": "/central-de-ajuda", "destination": "/" },
    { "source": "/configuracoes", "destination": "/" },
    { "source": "/blog", "destination": "https://love-blog.vercel.app/blog" },
    { "source": "/blog/:path*", "destination": "https://love-blog.vercel.app/blog/:path*" },
    { "source": "/:slug([a-z0-9-]+)", "destination": "/convite-preview.html" }
  ]
}
